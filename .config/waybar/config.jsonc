{
  "layer": "top",
  "position": "top",
  "width": 1920,
  "spacing": 10,
  "reload_style_on_change": false,
  "modules-left": [
    "hyprland/workspaces",
    "custom/user@host",
    // "network",
    "custom/internet",
    "tray"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "temperature#cpu",
    "temperature#gpu",
    "cpu",
    "pulseaudio",
    "pulseaudio/slider",
    "custom/power"
    // "custom/lock",
    // "custom/reboot",
    // "custom/poweroff"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "format": "{name} {icon}",
    "format-icons": {
      "1": "󰈹",
      "2": "",
      "3": "",
      "5": " ",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    },
    "ignore-workspaces": [
      "6",
      "7",
      "8",
      "9",
      "10"
    ]
  },
  "custom/user@host": {
    "format": "<span color='#7ea4ee'> </span>qoqoqo2<span color='#99A1C3'>@</span>hypr",
    "tooltip": false
  },
  "clock": {
    "interval": 1,
    "format": "{:%T}",
    "locale": "en_US.UTF-8",
    "tooltip": false,
    "on-click": "eww open --toggle calendar"
    /*
    "tooltip": true,
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-down": "shift_down",
      "on-scroll-up": "shift_up"
    }*/
  },
  "pulseaudio": {
    "on-click": "alacritty --class float-term -e wiremix",
    "on-click-right": "alacritty --class float-term -e bluetui",
    "format": "{volume}% {icon}",
    "format-muted": "mute",
    "format-icons": {
      "default": [
        // All colors here are made by oklch(0.8029 0.0979 h) converted to rgb
        "<span color='#9bbffe'> </span>", // light blue
        "<span color='#6ad0e2'> </span>", // teal
        "<span color='#87d2a6'> </span>", // lime
        "<span color='#afca84'> </span>", // charteuse
        "<span color='#c3c479'> </span><span color='#c3c479'> </span>", // yellow         warning so i dont explode my ears: 
        "<span color='#c3c479'> </span><span color='#dabb73'> </span>", // orange
        "<span color='#c3c479'> </span><span color='#f7a796'> </span>", // vermilion
        "<span color='#c3c479'> </span><span color='#f3a4bc'> </span>" // red
      ]
    }
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈁 Ethernet",
    "format-disconnected": "⚠ Disconnected",
    "tooltip": true
  },
  "custom/internet": {
    "exec": "~/.config/waybar/scripts/internet.sh",
    "format": "{}",
    "interval": 5
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": " {capacity}%",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ],
    "interval": 30
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "poweroff",
      "reboot": "reboot",
      "lock": "hyprlock",
      "suspend": "systemctl suspend"
    }
  },
  "custom/lock": {
    "format": "  ",
    "on-click": "hyprlock",
    "tooltip": true,
    "tooltip-format": "Lock"
  },
  "custom/reboot": {
    "format": "  ",
    "on-click": "reboot",
    "tooltip": true,
    "tooltip-format": "Reboot"
  },
  "custom/poweroff": {
    "format": "  ",
    "on-click": "poweroff",
    "tooltip": true,
    "tooltip-format": "Poweroff"
  },
  "cpu": {
    "tooltip": true,
    "interval": 1,
    "format": "{usage}% {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
    "format-icons": [
      // All colors here are made by oklch(0.8029 0.0979 h) converted to rgb
      " ",
      "<span color='#9bbffe'>▁</span>", // light blue
      "<span color='#6ad0e2'>▂</span>", // teal
      "<span color='#87d2a6'>▃</span>", // lime
      "<span color='#afca84'>▄</span>", // chartreuse
      "<span color='#c3c479'>▅</span>", // yellow
      "<span color='#dabb73'>▆</span>", // orange
      "<span color='#f7a796'>▇</span>", // vermilion
      "<span color='#f3a4bc'>█</span>" // red
    ]
  },
  "temperature#cpu": {
    "interval": 3,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 60,
    "critical-threshold": 85,
    "format": "CPU {temperatureC}°C {icon}",
    "format-icons": [
      "<span color='#9bbffe'></span>", // 0°C - 5°C
      "<span color='#9bbffe'></span>", // 5°C - 10°C
      "<span color='#9bbffe'></span>", // 10°C - 15°C
      "<span color='#9bbffe'></span>", // 15°C - 20°C
      "<span color='#9bbffe'></span>", // 20°C - 25°C
      "<span color='#9bbffe'></span>", // 25°C - 30°C
      "<span color='#6ad0e2'></span>", // 30°C - 35°C
      "<span color='#6ad0e2'></span>", // 35°C - 40°C
      "<span color='#6ad0e2'></span>", // 40°C - 45°C
      "<span color='#6ad0e2'></span>", // 45°C - 50°C
      "<span color='#87d2a6'></span>", // 50°C - 55°C
      "<span color='#87d2a6'></span>", // 55°C - 60°C
      "<span color='#afca84'></span>", // 60°C - 65°C -- Warning --
      "<span color='#c3c479'></span>", // 65°C - 70°C
      "<span color='#dabb73'></span>", // 70°C - 75°C
      "<span color='#f7a796'></span>", // 75°C - 80°C
      "<span color='#f3a4bc'></span>" // 80°C - 85°C+ -- Critical --
    ]
  },
  "temperature#gpu": {
    "interval": 3,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0/0000:03:00.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 50,
    "critical-threshold": 85,
    "format": "GPU {temperatureC}°C {icon}",
    "format-icons": [
      "<span color='#9bbffe'></span>", // 0°C - 5°C
      "<span color='#9bbffe'></span>", // 5°C - 10°C
      "<span color='#9bbffe'></span>", // 10°C - 15°C
      "<span color='#9bbffe'></span>", // 15°C - 20°C
      "<span color='#9bbffe'></span>", // 20°C - 25°C
      "<span color='#9bbffe'></span>", // 25°C - 30°C
      "<span color='#9bbffe'></span>", // 30°C - 35°C
      "<span color='#6ad0e2'></span>", // 35°C - 40°C
      "<span color='#6ad0e2'></span>", // 40°C - 45°C
      "<span color='#87d2a6'></span>", // 45°C - 50°C
      "<span color='#afca84'></span>", // 50°C - 55°C -- Warning
      "<span color='#c3c479'></span>", // 55°C - 60°C
      "<span color='#c3c479'></span>", // 60°C - 65°C
      "<span color='#dabb73'></span>", // 65°C - 70°C
      "<span color='#dabb73'></span>", // 70°C - 75°C
      "<span color='#f7a796'></span>", // 75°C - 80°C
      "<span color='#f3a4bc'></span>" // 80°C - 85°C+ -- Critical --
    ]
  }
}
